// 校园跑腿应用 - 完整单文件应用
// 适用于 DevEco Studio 6.1.1(24)

import { promptAction } from '@kit.ArkUI';

// 数据模型
interface OrderItem {
  id: number;
  type: number; // 1:代取快递 2:代买外卖 3:代打印 4:其他
  title: string;
  pickupAddress: string;
  deliveryAddress: string;
  reward: number;
  status: number; // 0:待接单 1:已接单 2:已取件 3:已送达 4:已完成 5:已取消
  createTime: string;
  publisher: string;
}

// 模拟数据
const MOCK_ORDERS: OrderItem[] = [
  {
    id: 1,
    type: 1,
    title: '菜鸟驿站取快递',
    pickupAddress: '菜鸟驿站(南门)',
    deliveryAddress: '6号楼305室',
    reward: 5.0,
    status: 0,
    createTime: '10分钟前',
    publisher: '张三'
  },
  {
    id: 2,
    type: 2,
    title: '麦当劳套餐',
    pickupAddress: '麦当劳(校门口店)',
    deliveryAddress: '8号楼501室',
    reward: 8.0,
    status: 0,
    createTime: '20分钟前',
    publisher: '李四'
  },
  {
    id: 3,
    type: 3,
    title: '打印论文资料',
    pickupAddress: '图书馆打印店',
    deliveryAddress: '4号楼201室',
    reward: 3.0,
    status: 0,
    createTime: '30分钟前',
    publisher: '王五'
  },
  {
    id: 4,
    type: 1,
    title: '顺丰快递',
    pickupAddress: '顺丰快递点(东门)',
    deliveryAddress: '10号楼102室',
    reward: 6.0,
    status: 1,
    createTime: '1小时前',
    publisher: '赵六'
  },
  {
    id: 5,
    type: 4,
    title: '帮忙搬书',
    pickupAddress: '图书馆一楼',
    deliveryAddress: '3号楼401室',
    reward: 10.0,
    status: 0,
    createTime: '2小时前',
    publisher: '钱七'
  }
];

@Entry
@Component
struct Index {
  @State orders: OrderItem[] = MOCK_ORDERS;
  @State currentTab: number = 0;
  @State selectedType: number = 0; // 0:全部 1:代取快递 2:代买外卖 3:代打印 4:其他
  @State showPublishDialog: boolean = false;
  @State showDetailDialog: boolean = false;
  @State selectedOrder: OrderItem | null = null;
  
  // 发布表单
  @State publishType: number = 1;
  @State publishTitle: string = '';
  @State publishPickup: string = '';
  @State publishDelivery: string = '';
  @State publishReward: string = '';

  // 获取订单类型文字
  getTypeText(type: number): string {
    const typeMap: Record<number, string> = {
      1: '代取快递',
      2: '代买外卖',
      3: '代打印',
      4: '其他'
    };
    return typeMap[type] || '未知';
  }

  // 获取订单类型图标
  getTypeIcon(type: number): string {
    const iconMap: Record<number, string> = {
      1: '📦',
      2: '🍔',
      3: '📄',
      4: '📋'
    };
    return iconMap[type] || '📋';
  }

  // 获取订单状态文字
  getStatusText(status: number): string {
    const statusMap: Record<number, string> = {
      0: '待接单',
      1: '已接单',
      2: '已取件',
      3: '已送达',
      4: '已完成',
      5: '已取消'
    };
    return statusMap[status] || '未知';
  }

  // 获取订单状态颜色
  getStatusColor(status: number): string {
    const colorMap: Record<number, string> = {
      0: '#FF9800',
      1: '#2196F3',
      2: '#4CAF50',
      3: '#9C27B0',
      4: '#8BC34A',
      5: '#F44336'
    };
    return colorMap[status] || '#999999';
  }

  // 筛选订单
  getFilteredOrders(): OrderItem[] {
    if (this.currentTab === 0) {
      // 首页：显示所有待接单订单
      return this.orders.filter(o => o.status === 0);
    } else if (this.currentTab === 2) {
      // 我的订单：显示自己发布的订单（这里模拟）
      return this.orders.filter(o => o.publisher === '我');
    }
    return [];
  }

  // 接单
  acceptOrder(order: OrderItem) {
    order.status = 1;
    promptAction.showToast({ message: '接单成功！' });
  }

  // 更新订单状态
  updateOrderStatus(order: OrderItem, newStatus: number) {
    order.status = newStatus;
    this.showDetailDialog = false;
    promptAction.showToast({ message: '状态已更新' });
  }

  // 发布订单
  publishOrder() {
    if (!this.publishTitle || !this.publishPickup || !this.publishDelivery || !this.publishReward) {
      promptAction.showToast({ message: '请填写完整信息' });
      return;
    }

    const newOrder: OrderItem = {
      id: this.orders.length + 1,
      type: this.publishType,
      title: this.publishTitle,
      pickupAddress: this.publishPickup,
      deliveryAddress: this.publishDelivery,
      reward: parseFloat(this.publishReward),
      status: 0,
      createTime: '刚刚',
      publisher: '我'
    };

    this.orders.unshift(newOrder);
    this.showPublishDialog = false;
    this.publishTitle = '';
    this.publishPickup = '';
    this.publishDelivery = '';
    this.publishReward = '';
    promptAction.showToast({ message: '发布成功！' });
  }

  build() {
    Column() {
      // 顶部标题栏
      Row() {
        Text('校园跑腿')
          .fontSize(20)
          .fontWeight(FontWeight.Bold)
          .fontColor('#FFFFFF')
      }
      .width('100%')
      .height(56)
      .backgroundColor('#FF6B35')
      .justifyContent(FlexAlign.Center)

      // 主内容区
      Tabs({ barPosition: BarPosition.Start }) {
        // 首页 Tab
        TabContent() {
          Column() {
            // 分类标签
            Scroll() {
              Row({ space: 12 }) {
                ForEach(['全部', '代取快递', '代买外卖', '代打印', '其他'], (item: string, index: number) => {
                  Text(item)
                    .fontSize(14)
                    .fontColor(this.selectedType === index ? '#FFFFFF' : '#666666')
                    .backgroundColor(this.selectedType === index ? '#FF6B35' : '#F5F5F5')
                    .padding({ left: 16, right: 16, top: 8, bottom: 8 })
                    .borderRadius(20)
                    .onClick(() => {
                      this.selectedType = index;
                    })
                })
              }
              .padding({ left: 16, right: 16, top: 12, bottom: 12 })
            }
            .scrollable(ScrollDirection.Horizontal)
            .scrollBar(BarState.Off)

            // 订单列表
            List() {
              ForEach(this.getFilteredOrders(), (order: OrderItem) => {
                ListItem() {
                  this.OrderCard(order)
                }
              })
            }
            .width('100%')
            .layoutWeight(1)
          }
          .width('100%')
          .height('100%')
          .backgroundColor('#F5F5F5')
        }
        .tabBar(this.TabBarItem(0, '首页', '🏠'))

        // 发布 Tab
        TabContent() {
          Column() {
            Button('发布新订单')
              .fontSize(16)
              .fontColor('#FFFFFF')
              .backgroundColor('#FF6B35')
              .width('80%')
              .height(48)
              .borderRadius(24)
              .margin({ top: 100 })
              .onClick(() => {
                this.showPublishDialog = true;
              })
          }
          .width('100%')
          .height('100%')
          .backgroundColor('#F5F5F5')
        }
        .tabBar(this.TabBarItem(1, '发布', '➕'))

        // 订单 Tab
        TabContent() {
          Column() {
            List() {
              ForEach(this.getFilteredOrders(), (order: OrderItem) => {
                ListItem() {
                  this.OrderCard(order)
                }
              })
            }
            .width('100%')
            .layoutWeight(1)
          }
          .width('100%')
          .height('100%')
          .backgroundColor('#F5F5F5')
        }
        .tabBar(this.TabBarItem(2, '订单', '📋'))

        // 我的 Tab
        TabContent() {
          Column() {
            // 用户信息
            Column() {
              Text('👤')
                .fontSize(60)
              Text('用户123')
                .fontSize(18)
                .fontWeight(FontWeight.Bold)
                .fontColor('#333333')
                .margin({ top: 12 })
              Text('余额: ¥100.00')
                .fontSize(14)
                .fontColor('#666666')
                .margin({ top: 8 })
            }
            .width('100%')
            .padding(24)
            .backgroundColor('#FFFFFF')
            .alignItems(HorizontalAlign.Center)

            // 菜单列表
            Column({ space: 1 }) {
              ForEach(['我的发布', '我的接单', '钱包', '设置'], (item: string) => {
                Row() {
                  Text(item)
                    .fontSize(16)
                    .fontColor('#333333')
                  Blank()
                  Text('>')
                    .fontSize(16)
                    .fontColor('#999999')
                }
                .width('100%')
                .height(56)
                .padding({ left: 24, right: 24 })
                .backgroundColor('#FFFFFF')
                .onClick(() => {
                  promptAction.showToast({ message: `${item}功能开发中` });
                })
              })
            }
            .margin({ top: 16 })
          }
          .width('100%')
          .height('100%')
          .backgroundColor('#F5F5F5')
        }
        .tabBar(this.TabBarItem(3, '我的', '👤'))
      }
      .barWidth('100%')
      .barHeight(56)
      .layoutWeight(1)
      .onChange((index: number) => {
        this.currentTab = index;
      })

      // 发布订单弹窗
      if (this.showPublishDialog) {
        this.PublishDialog()
      }

      // 订单详情弹窗
      if (this.showDetailDialog && this.selectedOrder) {
        this.DetailDialog(this.selectedOrder)
      }
    }
    .width('100%')
    .height('100%')
  }

  // 订单卡片
  @Builder
  OrderCard(order: OrderItem) {
    Column() {
      // 头部：类型图标 + 赏金
      Row() {
        Text(this.getTypeIcon(order.type))
          .fontSize(24)
        Column() {
          Text(this.getTypeText(order.type))
            .fontSize(14)
            .fontColor('#666666')
          Text(order.title)
            .fontSize(16)
            .fontWeight(FontWeight.Bold)
            .fontColor('#333333')
            .margin({ top: 4 })
        }
        .alignItems(HorizontalAlign.Start)
        .margin({ left: 12 })
        .layoutWeight(1)

        Column() {
          Text('¥')
            .fontSize(14)
            .fontColor('#FF6B35')
          Text(order.reward.toFixed(1))
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
            .fontColor('#FF6B35')
        }
        .alignItems(HorizontalAlign.End)
      }
      .width('100%')

      // 地址信息
      Column() {
        Row() {
          Text('📍')
            .fontSize(14)
          Text(order.pickupAddress)
            .fontSize(14)
            .fontColor('#666666')
            .margin({ left: 8 })
        }
        .width('100%')
        .margin({ top: 12 })

        Row() {
          Text('🏠')
            .fontSize(14)
          Text(order.deliveryAddress)
            .fontSize(14)
            .fontColor('#666666')
            .margin({ left: 8 })
        }
        .width('100%')
        .margin({ top: 8 })
      }
      .width('100%')
      .padding({ left: 36, right: 16 })

      // 底部：时间 + 状态 + 操作按钮
      Row() {
        Text(order.createTime)
          .fontSize(12)
          .fontColor('#999999')

        Blank()

        Text(this.getStatusText(order.status))
          .fontSize(12)
          .fontColor(this.getStatusColor(order.status))
          .margin({ right: 12 })

        if (order.status === 0) {
          Button('接单')
            .fontSize(14)
            .fontColor('#FFFFFF')
            .backgroundColor('#FF6B35')
            .height(32)
            .padding({ left: 16, right: 16 })
            .borderRadius(16)
            .onClick(() => {
              this.acceptOrder(order);
            })
        }

        Button('详情')
          .fontSize(14)
          .fontColor('#666666')
          .backgroundColor('#F5F5F5')
          .height(32)
          .padding({ left: 16, right: 16 })
          .borderRadius(16)
          .margin({ left: 8 })
          .onClick(() => {
            this.selectedOrder = order;
            this.showDetailDialog = true;
          })
      }
      .width('100%')
      .margin({ top: 12 })
    }
    .width('100%')
    .padding(16)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .margin({ left: 16, right: 16, top: 8, bottom: 8 })
    .shadow({
      radius: 4,
      color: 'rgba(0,0,0,0.1)',
      offsetX: 0,
      offsetY: 2
    })
  }

  // Tab栏项
  @Builder
  TabBarItem(index: number, title: string, icon: string) {
    Column() {
      Text(icon)
        .fontSize(24)
      Text(title)
        .fontSize(12)
        .fontColor(this.currentTab === index ? '#FF6B35' : '#999999')
        .margin({ top: 4 })
    }
    .width('100%')
    .height('100%')
    .justifyContent(FlexAlign.Center)
    .alignItems(HorizontalAlign.Center)
  }

  // 发布订单弹窗
  @Builder
  PublishDialog() {
    Column() {
      Column() {
        Text('发布订单')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor('#333333')
          .margin({ bottom: 24 })

        // 类型选择
        Text('订单类型')
          .fontSize(14)
          .fontColor('#666666')
          .margin({ bottom: 8 })
        Row({ space: 12 }) {
          ForEach(['代取快递', '代买外卖', '代打印', '其他'], (item: string, index: number) => {
            Text(item)
              .fontSize(14)
              .fontColor(this.publishType === index + 1 ? '#FFFFFF' : '#666666')
              .backgroundColor(this.publishType === index + 1 ? '#FF6B35' : '#F5F5F5')
              .padding({ left: 16, right: 16, top: 8, bottom: 8 })
              .borderRadius(20)
              .onClick(() => {
                this.publishType = index + 1;
              })
          })
        }
        .width('100%')
        .margin({ bottom: 16 })

        // 标题
        Text('订单标题')
          .fontSize(14)
          .fontColor('#666666')
          .margin({ bottom: 8 })
        TextInput({ placeholder: '请输入订单标题', text: this.publishTitle })
          .width('100%')
          .height(40)
          .onChange((value: string) => {
            this.publishTitle = value;
          })

        // 取件地址
        Text('取件地址')
          .fontSize(14)
          .fontColor('#666666')
          .margin({ top: 16, bottom: 8 })
        TextInput({ placeholder: '请输入取件地址', text: this.publishPickup })
          .width('100%')
          .height(40)
          .onChange((value: string) => {
            this.publishPickup = value;
          })

        // 送达地址
        Text('送达地址')
          .fontSize(14)
          .fontColor('#666666')
          .margin({ top: 16, bottom: 8 })
        TextInput({ placeholder: '请输入送达地址', text: this.publishDelivery })
          .width('100%')
          .height(40)
          .onChange((value: string) => {
            this.publishDelivery = value;
          })

        // 赏金
        Text('赏金(元)')
          .fontSize(14)
          .fontColor('#666666')
          .margin({ top: 16, bottom: 8 })
        TextInput({ placeholder: '请输入赏金', text: this.publishReward })
          .width('100%')
          .height(40)
          .type(InputType.NUMBER_DECIMAL)
          .onChange((value: string) => {
            this.publishReward = value;
          })

        // 按钮
        Row({ space: 12 }) {
          Button('取消')
            .fontSize(16)
            .fontColor('#666666')
            .backgroundColor('#F5F5F5')
            .layoutWeight(1)
            .height(44)
            .onClick(() => {
              this.showPublishDialog = false;
            })

          Button('发布')
            .fontSize(16)
            .fontColor('#FFFFFF')
            .backgroundColor('#FF6B35')
            .layoutWeight(1)
            .height(44)
            .onClick(() => {
              this.publishOrder();
            })
        }
        .width('100%')
        .margin({ top: 24 })
      }
      .width('90%')
      .padding(24)
      .backgroundColor('#FFFFFF')
      .borderRadius(16)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('rgba(0,0,0,0.5)')
    .justifyContent(FlexAlign.Center)
    .alignItems(HorizontalAlign.Center)
    .onClick(() => {
      this.showPublishDialog = false;
    })
  }

  // 订单详情弹窗
  @Builder
  DetailDialog(order: OrderItem) {
    Column() {
      Column() {
        Text('订单详情')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor('#333333')
          .margin({ bottom: 24 })

        // 订单信息
        Column({ space: 12 }) {
          Row() {
            Text('订单类型:')
              .fontSize(14)
              .fontColor('#666666')
            Text(this.getTypeText(order.type))
              .fontSize(14)
              .fontColor('#333333')
              .margin({ left: 12 })
          }
          .width('100%')

          Row() {
            Text('订单标题:')
              .fontSize(14)
              .fontColor('#666666')
            Text(order.title)
              .fontSize(14)
              .fontColor('#333333')
              .margin({ left: 12 })
          }
          .width('100%')

          Row() {
            Text('取件地址:')
              .fontSize(14)
              .fontColor('#666666')
            Text(order.pickupAddress)
              .fontSize(14)
              .fontColor('#333333')
              .margin({ left: 12 })
          }
          .width('100%')

          Row() {
            Text('送达地址:')
              .fontSize(14)
              .fontColor('#666666')
            Text(order.deliveryAddress)
              .fontSize(14)
              .fontColor('#333333')
              .margin({ left: 12 })
          }
          .width('100%')

          Row() {
            Text('赏金:')
              .fontSize(14)
              .fontColor('#666666')
            Text(`¥${order.reward.toFixed(1)}`)
              .fontSize(14)
              .fontColor('#FF6B35')
              .margin({ left: 12 })
          }
          .width('100%')

          Row() {
            Text('状态:')
              .fontSize(14)
              .fontColor('#666666')
            Text(this.getStatusText(order.status))
              .fontSize(14)
              .fontColor(this.getStatusColor(order.status))
              .margin({ left: 12 })
          }
          .width('100%')

          Row() {
            Text('发布时间:')
              .fontSize(14)
              .fontColor('#666666')
            Text(order.createTime)
              .fontSize(14)
              .fontColor('#333333')
              .margin({ left: 12 })
          }
          .width('100%')
        }
        .width('100%')
        .margin({ bottom: 24 })

        // 操作按钮
        if (order.status === 1) {
          Button('标记已取件')
            .fontSize(16)
            .fontColor('#FFFFFF')
            .backgroundColor('#4CAF50')
            .width('100%')
            .height(44)
            .margin({ bottom: 12 })
            .onClick(() => {
              this.updateOrderStatus(order, 2);
            })
        }

        if (order.status === 2) {
          Button('标记已送达')
            .fontSize(16)
            .fontColor('#FFFFFF')
            .backgroundColor('#9C27B0')
            .width('100%')
            .height(44)
            .margin({ bottom: 12 })
            .onClick(() => {
              this.updateOrderStatus(order, 3);
            })
        }

        if (order.status === 3) {
          Button('标记已完成')
            .fontSize(16)
            .fontColor('#FFFFFF')
            .backgroundColor('#8BC34A')
            .width('100%')
            .height(44)
            .margin({ bottom: 12 })
            .onClick(() => {
              this.updateOrderStatus(order, 4);
            })
        }

        Button('关闭')
          .fontSize(16)
          .fontColor('#666666')
          .backgroundColor('#F5F5F5')
          .width('100%')
          .height(44)
          .onClick(() => {
            this.showDetailDialog = false;
          })
      }
      .width('85%')
      .padding(24)
      .backgroundColor('#FFFFFF')
      .borderRadius(16)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('rgba(0,0,0,0.5)')
    .justifyContent(FlexAlign.Center)
    .alignItems(HorizontalAlign.Center)
    .onClick(() => {
      this.showDetailDialog = false;
    })
  }
}
